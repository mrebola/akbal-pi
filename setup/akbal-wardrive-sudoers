# Regla sudoers para wardriving + WiFi Radar: los helpers que la app corre con
# `sudo -n` (modo monitor, canal, captura y deauth). Sin esto, "entrar a modo
# monitor" falla con "sudo: a password is required".
# Ver app/src/wardrive/ y app/src/wifiradar/.
#
# Instalar:
#   sudo install -m 0440 -o root -g root akbal-wardrive-sudoers /etc/sudoers.d/010-akbal-wardrive
#   sudo visudo -c -f /etc/sudoers.d/010-akbal-wardrive
akbal ALL=(root) NOPASSWD: /usr/sbin/iw, /usr/bin/iw, /usr/bin/ip, /usr/sbin/ip, /sbin/ip, /usr/bin/dumpcap, /usr/bin/hcxdumptool, /usr/bin/systemd-run, /usr/sbin/aireplay-ng, /usr/bin/aireplay-ng, /usr/sbin/airodump-ng, /usr/bin/airodump-ng, /usr/sbin/airmon-ng
