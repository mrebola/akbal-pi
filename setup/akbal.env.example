# Configuración de referencia usada en akbal-pi (todo local, sin API keys de nube).
# Basado en .env.template de whisplay-ai-chatbot. Copiar como .env dentro de esa
# carpeta y ajustar rutas/usuario según corresponda.

# --- Selección de servidores (100% local) ---
ASR_SERVER=faster-whisper
LLM_SERVER=ollama
TTS_SERVER=piper-http

# --- LLM local (Ollama) ---
OLLAMA_ENDPOINT=http://localhost:11434
# Ver docs/llm-model-selection.md para por qué este modelo y no qwen3:1.7b
# (original) o Qwen3.5-4B-Uncensored-GGUF (probado y descartado: muy lento y
# no cortaba la generación).
OLLAMA_MODEL=huihui_ai/qwen3.5-abliterated:2B
# Estos modelos soportan "thinking", pero para un asistente de voz conviene
# desactivarlo por latencia (sin esto, cada respuesta tarda ~30s en vez de
# unos pocos segundos).
ENABLE_THINKING=false

# --- ASR local (faster-whisper) ---
# "small" tardaba ~5.2s en transcribir un audio de 2.9s en este hardware (más
# lento que tiempo real). "base" tarda ~1.8s con precisión todavía razonable
# en español; "tiny" es aun más rápido (~1s) pero notablemente menos preciso.
# Ver docs/performance-tuning.md para las mediciones completas.
FASTER_WHISPER_MODEL_SIZE_OR_PATH=base
FASTER_WHISPER_LANGUAGE=es
FASTER_WHISPER_PORT=8803
FASTER_WHISPER_HOST=localhost
# beam_size=1 y cpu_threads=4 ya están fijados en
# app/python/speech-service/faster-whisper-host.py (no son variables de .env).

# --- TTS local (Piper) ---
# Voz de hombre, español de España. Verificada con estimación real de F0
# (~118 Hz, rango masculino), no por el nombre del modelo — ver
# docs/piper-voice-selection.md para la metodología y otras voces probadas
# (es_MX-claude-high, es_MX-ald-medium, es_ES-carlfm-x_low).
# Descargada con: python3 -m piper.download_voices es_ES-davefx-medium
PIPER_HTTP_MODEL=/home/akbal/piper/es_ES-davefx-medium
PIPER_HTTP_LENGTH_SCALE=1

# --- Personalidad ---
SYSTEM_PROMPT="Eres Akbal, un asistente de IA que corre localmente en una Raspberry Pi. Responde en espanol, de forma breve y natural para texto a voz."

# --- Audio ---
# Sin esto, el volumen vuelve a 60% (default) en cada reinicio del servicio.
INITIAL_VOLUME_PERCENT=60
