# Configuración de referencia usada en akbal-pi (todo local, sin API keys de nube).
# Basado en .env.template de whisplay-ai-chatbot. Copiar como .env dentro de esa
# carpeta y ajustar rutas/usuario según corresponda.

# --- Selección de servidores (100% local) ---
ASR_SERVER=faster-whisper
LLM_SERVER=ollama
TTS_SERVER=piper-http

# --- LLM local (Ollama) ---
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b
# Qwen3 soporta "thinking", pero para un asistente de voz conviene desactivarlo
# por latencia (sin esto, cada respuesta tarda ~30s en vez de unos pocos segundos).
ENABLE_THINKING=false

# --- ASR local (faster-whisper) ---
# "small" da buen balance precisión/latencia en CPU del Pi 5. "tiny"/"base" son
# más rápidos pero menos precisos en español.
FASTER_WHISPER_MODEL_SIZE_OR_PATH=small
FASTER_WHISPER_LANGUAGE=es
FASTER_WHISPER_PORT=8803
FASTER_WHISPER_HOST=localhost

# --- TTS local (Piper) ---
# Voz descargada con: python3 -m piper.download_voices es_MX-claude-high
PIPER_HTTP_MODEL=/home/akbal/piper/es_MX-claude-high
PIPER_HTTP_LENGTH_SCALE=1

# --- Personalidad ---
SYSTEM_PROMPT="Eres Akbal, un asistente de IA que corre localmente en una Raspberry Pi. Responde en espanol, de forma breve y natural para texto a voz."
